# Copie para .env.local e preencha.

# Senha para entrar no modo admin (criar edições, lançar placares).
ADMIN_PASSWORD=
# Chave que assina o cookie de login (qualquer texto longo e aleatório).
AUTH_SECRET=

# Banco na nuvem (Turso). Sem estas variáveis, usa o arquivo local ./data/copinha.db
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=
