# Copie para .env.local e preencha.

# Senha para entrar no modo admin (criar edições, lançar placares).
ADMIN_PASSWORD=
# Chave que assina o cookie de login (qualquer texto longo e aleatório).
AUTH_SECRET=

# Banco na nuvem (Turso). Sem estas variáveis, usa o arquivo local ./data/copinha.db
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=

# Têm prioridade sobre as do Turso. Use na Vercel para apontar sempre para o
# banco principal (a integração do Turso cria uma branch por deploy).
# COPINHA_DATABASE_URL=libsql://seu-banco-principal.turso.io
# COPINHA_DATABASE_TOKEN=

# Endereço público do site (para a imagem de pré-visualização no WhatsApp).
# Na Vercel é detectado sozinho; só defina se usar domínio próprio.
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br
